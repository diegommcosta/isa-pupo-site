# Sanity — crie seu projeto em https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=seu_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=seu_token_leitura

# Webhook on-demand revalidation (gere uma string aleatória segura)
SANITY_REVALIDATE_SECRET=seu_secret_aleatorio

# WhatsApp (só o número, sem +55, sem espaços, ex: 11999998888)
NEXT_PUBLIC_WHATSAPP_NUMBER=11999998888
